FoamFile { version 2.0; format ascii; class dictionary; object fvSchemes; }
fluxScheme HLLC;
ddtSchemes { default Euler; timeIntegrator Euler; }
gradSchemes { default cellLimited leastSquares 1; }
divSchemes { default none; div(alphaRhoPhi.tnt,lambda.tnt) Gauss upwind; }
laplacianSchemes { default Gauss linear corrected; }
interpolationSchemes { default linear; reconstruct(alpha) upwind; reconstruct(rho) upwind;
 reconstruct(U) upwind; reconstruct(e) upwind; reconstruct(p) upwind;
 reconstruct(speedOfSound) upwind; reconstruct(lambda.tnt) upwind; }
snGradSchemes { default corrected; }
